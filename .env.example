# DUMMY values for development only. Replace before production.
# Do NOT hardcode real email / WhatsApp in source. Read via lib/site-config.ts only.
# NEXT_PUBLIC_SITE_URL must include protocol (https://...). If unset, the app
# falls back to Vercel's deployment URL on Vercel, else http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@xplor.digital
# International digits, no "+" / spaces (e.g. 6281234567890). Leading 0 is
# auto-normalized to 62, but prefer storing the 62... form directly.
NEXT_PUBLIC_WA_NUMBER=6281234567890
NEXT_PUBLIC_DEFAULT_LANG=id

# --- Lead delivery (SERVER-ONLY, never NEXT_PUBLIC_; never commit real values) ---
# DUMMY placeholders. Fill with real values in the hosting env (Vercel/Termux).
# When unset, /api/contact and /api/newsletter run in mock mode (log only).
# RESEND_API_KEY=
# LEAD_TO_EMAIL=leads@example.com
# LEAD_FROM_EMAIL=onboarding@resend.dev
